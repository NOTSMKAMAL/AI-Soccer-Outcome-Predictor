rules_version = '2';

// Paste into Firebase Console → Firestore Database → Rules, then Publish.
//
// Browsers get no access at all. The backend reads and writes the daily prediction
// counts through the Firebase Admin SDK, which is not subject to these rules, and
// the frontend does not use Firestore.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
