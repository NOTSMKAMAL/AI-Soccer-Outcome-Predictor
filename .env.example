# ── Gemini (required for predictions) ─────────────────────────────────────────
# Free API key: https://aistudio.google.com → Get API key
GEMINI_API_KEY=

# ── football-data.org (required for live fixtures) ────────────────────────────
# Free tier: 10 requests/minute. Register at https://www.football-data.org/client/register
# Sent as the X-Auth-Token header. If absent, the fixtures page falls back to mock data.
# Covers Premier League, Bundesliga, La Liga, Serie A, Ligue 1 and Champions League.
FOOTBALL_DATA_API_KEY=

# The client throttles itself on football-data.org's own X-RequestsAvailable /
# X-RequestCounter-Reset response headers. These only need changing if your plan
# allows more than the free 10 requests/minute, or you want calls to wait longer
# before degrading to cached data.
# FOOTBALL_DATA_MAX_PER_MINUTE=10
# FOOTBALL_DATA_MAX_WAIT=12

# ── Firebase Admin SDK (backend token verification) ───────────────────────────
# Option A (local): path to the service account JSON downloaded from
#   Firebase Console → Project Settings → Service Accounts → Generate new private key
#   Save it as serviceAccountKey.json in the project root (it is in .gitignore).
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B (hosting): paste the whole service-account JSON as one line instead of
#   shipping the file. Set this OR the path above, not both.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Option C: set your Firebase project ID and authenticate the host with
#   Application Default Credentials (gcloud auth application-default login).
# FIREBASE_PROJECT_ID=your-firebase-project-id

# ── Access control (who may spend Gemini credit) ──────────────────────────────
# Comma-separated allowlist of Firebase account emails permitted to generate
# predictions. Leave EMPTY for local development (any signed-in account works);
# set it before handing out a public link. "*@domain.com" allows a whole domain.
# ALLOWED_EMAILS=you@gmail.com,friend@gmail.com

# Daily prediction caps (Gemini cost control). Both reset at 00:00 UTC.
PREDICTIONS_PER_USER_PER_DAY=25
PREDICTIONS_PER_DAY_TOTAL=200

# Browser origins allowed to call the API. Leave empty locally; set it to your
# deployed frontend URL in production, e.g. https://your-app.vercel.app
# ALLOWED_ORIGINS=
