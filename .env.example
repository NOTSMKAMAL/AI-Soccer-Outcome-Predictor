# ── SportMonks ────────────────────────────────────────────────────────────────
SPORTMONKS_API_KEY=

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=


# ── Firebase Admin SDK (backend token verification) ───────────────────────────
# Option A (recommended): path to the service account JSON downloaded from
#   Firebase Console → Project Settings → Service Accounts → Generate new private key
#   Save the file as serviceAccountKey.json in the project root (it is in .gitignore).
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B: if you cannot use a service account file, set your Firebase project ID
#   and authenticate locally with: gcloud auth application-default login
# FIREBASE_PROJECT_ID=your-firebase-project-id

# ── Legacy API Football (not used by current prediction flow) ─────────────────
APIFOOTBALL_API_KEY=
